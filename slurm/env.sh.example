# Copied to slurm/env.sh and sourced by every job: whatever the cluster needs
# before `python -m tsgo...` works. The solver pins Python 3.11 (pyproject.toml);
# the campus cluster's default python module is 3.13, so load 3.11 explicitly.
#
# One-time setup, on a login node, from the repository root:
#
#   module load python/3.11.11
#   python -m venv .venv && source .venv/bin/activate
#   python -m pip install -r requirements.txt gurobipy && python -m pip install -e .
#   # IPOPT baseline: Ipopt from conda-forge, cyipopt built against it
#   module load miniconda3/24.9.2
#   conda create -y -p "$PWD/.ipopt" -c conda-forge --override-channels "ipopt=3.14" pkg-config
#   PKG_CONFIG_PATH="$PWD/.ipopt/lib/pkgconfig" python -m pip install cyipopt==1.5.0
module load python/3.11.11
source .venv/bin/activate
export LD_LIBRARY_PATH="$PWD/.ipopt/lib:${LD_LIBRARY_PATH:-}"
